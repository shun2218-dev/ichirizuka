# Google スプレッドシートの ID（URL の /d/ と /edit の間）
SHEET_ID=your-spreadsheet-id-here
# 「Running」タブの gid（タブを開いたときの URL 末尾 #gid=xxx）
SHEET_GID=0
# 上記から URL を自動生成しますが、直接指定したいときはこちら（任意）
# SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-xxxx/pub?gid=1&single=true&output=csv

# 「Daily」タブの gid（任意）。設定するとコンディションのセクションが出ます
# 集めかたは docs/daily-metrics-setup.md
# SHEET_DAILY_GID=123456789
# Daily タブの CSV URL を直接指定したいときはこちら（任意）
# SHEET_DAILY_CSV_URL=

# 過去分の取り込みスクリプトだけが使います（アプリは読みません）
# scripts/import-health-export.mjs --post の送信先
# SHEET_WEBAPP_URL=https://script.google.com/macros/s/xxxx/exec
# Apps Script の TOKEN と同じ文字列。実際の値はここに書かないこと
# SHEET_WEBAPP_TOKEN=

# 週の目標距離 (km)
WEEKLY_TARGET_KM=30
