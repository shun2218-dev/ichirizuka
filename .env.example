# Google スプレッドシートの ID（URL の /d/ と /edit の間）
SHEET_ID=your-spreadsheet-id-here
# 「Running」タブの gid（タブを開いたときの URL 末尾 #gid=xxx）
SHEET_GID=0
# 上記から URL を自動生成しますが、直接指定したいときはこちら（任意）
# SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-xxxx/pub?gid=1&single=true&output=csv

# 「Daily」タブの gid（任意）。設定するとコンディションのセクションが出ます
# 集めかたは docs/daily-metrics-setup.md
# SHEET_DAILY_GID=123456789
# Daily タブの CSV URL を直接指定したいときはこちら（任意）
# SHEET_DAILY_CSV_URL=

# 「Fit」タブの gid（任意）。FIT から取り込んだ心拍ゾーン滞在時間などを読みます
# 入れかたは docs/fit-import-setup.md
# SHEET_FIT_GID=123456789
# Fit タブの CSV URL を直接指定したいときはこちら（任意）
# SHEET_FIT_CSV_URL=

# 「Settings」タブの gid（任意）。目標タイム・レース日・練習可能曜日を読みます
# 作りかたは docs/settings-sheet.md
# SHEET_SETTINGS_GID=123456789
# Settings タブの CSV URL を直接指定したいときはこちら（任意）
# SHEET_SETTINGS_CSV_URL=

# 取り込みスクリプトだけが使います（アプリは読みません）
# scripts/import-health-export.mjs --post / scripts/import-fit.mjs --post の送信先
# SHEET_WEBAPP_URL=https://script.google.com/macros/s/xxxx/exec
# Apps Script の TOKEN と同じ文字列。実際の値はここに書かないこと
# SHEET_WEBAPP_TOKEN=

# 週の目標距離 (km)。Settings タブに weekly_target_km があればそちらが優先されます
WEEKLY_TARGET_KM=30

# Basic 認証（任意）。両方そろったときだけ有効になり、片方でも欠けると素通しします
# 個人用なので URL を知られただけで記録が読める状態を塞ぐためのもの
# BASIC_AUTH_USER=your-name
# BASIC_AUTH_PASSWORD=change-me
